@model TelefonoDto
@{
    var esEdicion = ViewData["EsEdicion"] as bool? ?? false;
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="mb-3">
    <label asp-for="Num" class="form-label"></label>
    @if (esEdicion)
    {
        <input asp-for="Num" class="form-control" readonly />
        <div class="form-text">El número no se puede modificar.</div>
    }
    else
    {
        <input asp-for="Num" class="form-control" placeholder="3001234567" />
    }
    <span asp-validation-for="Num" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Oper" class="form-label"></label>
    <input asp-for="Oper" class="form-control" placeholder="Claro, Movistar, Tigo..." />
    <span asp-validation-for="Oper" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Duenio" class="form-label"></label>
    <select asp-for="Duenio" asp-items="ViewBag.Personas" class="form-select">
        <option value="0">-- Seleccione la persona --</option>
    </select>
    <span asp-validation-for="Duenio" class="text-danger"></span>
</div>
