@model TelefonoDto
@{
    ViewData["Title"] = "Eliminar teléfono";
}

<h1 class="h3 mb-3">Eliminar teléfono</h1>

<div class="alert alert-warning">¿Seguro que desea eliminar este teléfono? Esta acción no se puede deshacer.</div>

<dl class="row">
    <dt class="col-sm-3">Número</dt>
    <dd class="col-sm-9">@Model.Num</dd>
    <dt class="col-sm-3">Operador</dt>
    <dd class="col-sm-9">@Model.Oper</dd>
    <dt class="col-sm-3">Dueño</dt>
    <dd class="col-sm-9">@Model.DuenioNombre (@Model.Duenio)</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Num" method="post">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
