@model IEnumerable<TelefonoDto>
@{
    ViewData["Title"] = "Teléfonos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Teléfonos</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo teléfono</a>
</div>

<partial name="_Alerts" />

@if (!Model.Any())
{
    <p class="text-muted">No hay teléfonos registrados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Número</th>
                    <th>Operador</th>
                    <th>Dueño</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.Num</td>
                        <td>@t.Oper</td>
                        <td>
                            <a asp-controller="Personas" asp-action="Details" asp-route-id="@t.Duenio">@t.DuenioNombre</a>
                            <span class="text-muted small">(@t.Duenio)</span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@t.Num" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@t.Num" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@t.Num" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
