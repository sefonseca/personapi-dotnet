@model IEnumerable<PersonaDto>
@{
    ViewData["Title"] = "Personas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Personas</h1>
    <a asp-action="Create" class="btn btn-primary">Nueva persona</a>
</div>

<partial name="_Alerts" />

@if (!Model.Any())
{
    <p class="text-muted">No hay personas registradas.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Cédula</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Género</th>
                    <th>Edad</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Cc</td>
                        <td>@p.Nombre</td>
                        <td>@p.Apellido</td>
                        <td>@(p.Genero == "M" ? "Masculino" : "Femenino")</td>
                        <td>@(p.Edad?.ToString() ?? "—")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@p.Cc" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@p.Cc" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@p.Cc" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
