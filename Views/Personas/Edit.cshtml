@model PersonaDto
@{
    ViewData["EsEdicion"] = true;
    ViewData["Title"] = "Editar persona";
}

<h1 class="h3 mb-3">Editar persona</h1>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Edit" asp-route-id="@Model.Cc" method="post">
            <partial name="_Form" model="Model" />
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
