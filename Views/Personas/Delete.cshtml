@model PersonaDto
@{
    ViewData["Title"] = "Eliminar persona";
}

<h1 class="h3 mb-3">Eliminar persona</h1>

<div class="alert alert-warning">¿Seguro que desea eliminar esta persona? Esta acción no se puede deshacer.</div>

<dl class="row">
    <dt class="col-sm-3">Cédula</dt>
    <dd class="col-sm-9">@Model.Cc</dd>
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre @Model.Apellido</dd>
    <dt class="col-sm-3">Género</dt>
    <dd class="col-sm-9">@(Model.Genero == "M" ? "Masculino" : "Femenino")</dd>
    <dt class="col-sm-3">Edad</dt>
    <dd class="col-sm-9">@(Model.Edad?.ToString() ?? "—")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Cc" method="post">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
