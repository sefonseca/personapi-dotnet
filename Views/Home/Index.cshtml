@using Microsoft.Extensions.Configuration
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Inicio";
    var swaggerEnabled = Configuration.GetValue<bool>("Swagger:Enabled");
    var modulos = new[]
    {
        (Controller: "Personas",    Titulo: "Personas",    Texto: "Registro de personas por cédula."),
        (Controller: "Profesiones", Titulo: "Profesiones", Texto: "Catálogo de profesiones."),
        (Controller: "Estudios",    Titulo: "Estudios",    Texto: "Profesiones estudiadas por cada persona."),
        (Controller: "Telefonos",   Titulo: "Teléfonos",   Texto: "Teléfonos y su operador por persona.")
    };
}

<div class="py-4">
    <h1 class="display-6">PersonAPI</h1>
    <p class="lead text-muted">Monolito ASP.NET Core MVC con patrón DAO, API REST y Swagger.</p>
</div>

<div class="row g-3">
    @foreach (var m in modulos)
    {
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@m.Titulo</h5>
                    <p class="card-text text-muted flex-grow-1">@m.Texto</p>
                    <a class="btn btn-primary" asp-controller="@m.Controller" asp-action="Index">Administrar</a>
                </div>
            </div>
        </div>
    }
</div>

<div class="mt-4">
    @if (swaggerEnabled)
    {
        <a class="btn btn-outline-secondary" href="~/swagger">Documentación de la API (Swagger)</a>
    }
    else
    {
        <span class="text-muted small">Swagger está deshabilitado en este ambiente.</span>
    }
</div>
