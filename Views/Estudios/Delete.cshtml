@model EstudioDto
@{
    ViewData["Title"] = "Eliminar estudio";
}

<h1 class="h3 mb-3">Eliminar estudio</h1>

<div class="alert alert-warning">¿Seguro que desea eliminar este estudio? Esta acción no se puede deshacer.</div>

<dl class="row">
    <dt class="col-sm-3">Persona</dt>
    <dd class="col-sm-9">@Model.PersonaNombre (@Model.CcPer)</dd>
    <dt class="col-sm-3">Profesión</dt>
    <dd class="col-sm-9">@Model.ProfesionNombre</dd>
    <dt class="col-sm-3">Universidad</dt>
    <dd class="col-sm-9">@(Model.Univer ?? "—")</dd>
    <dt class="col-sm-3">Fecha de grado</dt>
    <dd class="col-sm-9">@(Model.Fecha?.ToString("yyyy-MM-dd") ?? "—")</dd>
</dl>

<form asp-action="Delete" asp-route-idProf="@Model.IdProf" asp-route-ccPer="@Model.CcPer" method="post">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
