@model EstudioDto
@{
    ViewData["Title"] = "Nuevo estudio";
}

<h1 class="h3 mb-3">Nuevo estudio</h1>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CcPer" class="form-label"></label>
                    <select asp-for="CcPer" asp-items="ViewBag.Personas" class="form-select">
                        <option value="0">-- Seleccione la persona --</option>
                    </select>
                    <span asp-validation-for="CcPer" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="IdProf" class="form-label"></label>
                    <select asp-for="IdProf" asp-items="ViewBag.Profesiones" class="form-select">
                        <option value="0">-- Seleccione la profesión --</option>
                    </select>
                    <span asp-validation-for="IdProf" class="text-danger"></span>
                </div>
            </div>

            <partial name="_CamposEditables" model="Model" />

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
