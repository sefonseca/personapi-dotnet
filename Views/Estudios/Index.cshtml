@model IEnumerable<EstudioDto>
@{
    ViewData["Title"] = "Estudios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Estudios</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo estudio</a>
</div>

<partial name="_Alerts" />

@if (!Model.Any())
{
    <p class="text-muted">No hay estudios registrados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Persona</th>
                    <th>Profesión</th>
                    <th>Universidad</th>
                    <th>Fecha de grado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>
                            <a asp-controller="Personas" asp-action="Details" asp-route-id="@e.CcPer">@e.PersonaNombre</a>
                            <span class="text-muted small">(@e.CcPer)</span>
                        </td>
                        <td>@e.ProfesionNombre</td>
                        <td>@(e.Univer ?? "—")</td>
                        <td>@(e.Fecha?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-idProf="@e.IdProf" asp-route-ccPer="@e.CcPer" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-idProf="@e.IdProf" asp-route-ccPer="@e.CcPer" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-idProf="@e.IdProf" asp-route-ccPer="@e.CcPer" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
